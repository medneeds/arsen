# Variáveis de ambiente do ARSen
# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# O .env NUNCA deve ser commitado (está no .gitignore).

# ID do projeto Supabase (visível na URL do dashboard)
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# Chave anon/publishable (pública por design — usada no frontend)
# Encontre em: Supabase Dashboard > Settings > API > Project API keys > anon public
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# URL do projeto Supabase
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
